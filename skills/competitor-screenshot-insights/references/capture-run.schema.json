{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capture-run.schema.json",
  "title": "Competitor Screenshot Capture Run",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "case_id",
    "skill_hash",
    "variant",
    "started_at",
    "environment",
    "attempts",
    "fallback_chain",
    "final_task_result",
    "current_stage",
    "completed_stages",
    "stage_timings_ms",
    "metrics",
    "status",
    "decision"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "skill_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "variant": {"enum": ["baseline", "candidate"]},
    "started_at": {"type": "string"},
    "environment": {"type": "object"},
    "attempts": {"type": "array", "items": {"type": "object"}},
    "fallback_chain": {"type": "array", "items": {"type": "object"}},
    "final_task_result": {"enum": ["running", "pass", "pass_with_warnings", "fail"]},
    "current_stage": {"type": "string"},
    "completed_stages": {"type": "array", "items": {"type": "string"}},
    "stage_timings_ms": {"type": "object"},
    "metrics": {"type": "object"},
    "failure": {"type": ["object", "null"]},
    "viewport_evidence_pack": {"type": ["string", "null"]},
    "status": {"enum": ["running", "complete", "failed"]},
    "decision": {"type": ["string", "null"]}
  }
}
